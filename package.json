{
  "name": "jade",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "jade": "./index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:embed": "JADE_VERIFY_COMPILE_EMBED=1 bun test src/commands/__tests__/skills-embed-compile.test.ts",
    "jade": "bun run index.ts",
    "build": "bun build --compile ./index.ts --outfile jade",
    "install-global": "bun run build && mkdir -p ~/.local/bin && mv jade ~/.local/bin/",
    "uninstall": "rm -f ~/.local/bin/jade && echo '✓ Removed jade from ~/.local/bin'"
  },
  "devDependencies": {
    "@types/bun": "1.3.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "citty": "^0.2.1"
  }
}
