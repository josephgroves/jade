{
  "name": "jade-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "jade": "bun run --cwd packages/cli jade",
    "build": "bun run --cwd packages/cli build",
    "install-global": "bun run --cwd packages/cli install-global",
    "uninstall": "bun run --cwd packages/cli uninstall"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "knip": "^6.32.2",
    "typescript": "^7.0.2"
  }
}
